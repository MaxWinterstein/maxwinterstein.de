---
import Base from "../layouts/Base.astro";
import Prompt from "../components/Prompt.astro";
import Titlebar from "../components/Titlebar.astro";
import { site, links, CANONICAL_DOMAIN } from "../config";

const host = CANONICAL_DOMAIN;

// Strip scheme / mailto / trailing slash for a clean terminal-style display.
const display = (href: string) =>
  href
    .replace(/^mailto:/, "")
    .replace(/^https?:\/\//, "")
    .replace(/\/$/, "");

const contacts = links.map(({ label, href }) => ({
  // Lowercased because the shell compares against the lowercased typed word;
  // a `Mastodon` label would otherwise be listed but not runnable.
  label: label.toLowerCase(),
  href,
  display: display(href),
}));

// The commands the intro replays. Each string is the single source for both
// the server-rendered prompt line and the text the intro types into it.
const CMD = {
  who: "whoami",
  role: "cat role.txt",
  about: "cat about.txt",
  contact: "ls contact/",
};

// The shell's virtual filesystem — drives `ls`, `cat` and tab completion.
const files = {
  "role.txt": { text: site.tagline, cls: "accent" },
  "about.txt": { text: site.about.join("\n"), cls: "out" },
  "datenschutz.txt": {
    text: `Keine Cookies, kein Local Storage, keine Analyse- oder Tracking-Dienste.\nVolltext: https://${host}/datenschutz/`,
    cls: "out",
  },
};

// Handed to the shell through a data attribute rather than `define:vars`: that
// directive forces `is:inline`, and Astro only emits CSP hashes for scripts it
// processes, so an inline script would be blocked by our own policy.
const shell = {
  host,
  siteName: site.name,
  tagline: site.tagline,
  contacts,
  files,
};
---

<Base>
  <div class="terminal">
    <Titlebar title={`guest@${host}: ~`} interactive />

    <div class="screen" id="screen" data-shell={JSON.stringify(shell)}>
      {
        /*
        The intro *reveals* these server-rendered blocks rather than rebuilding
        them, so there is exactly one copy of the session in the codebase and
        no-JS visitors and crawlers see the finished article.
      */
      }
      <div id="output" aria-live="polite">
        <div class="cmdblock" data-cmd={CMD.who}>
          <div class="line"><Prompt /><span class="cmd">{CMD.who}</span></div>
          <div class="blockout">
            <div class="line out"><h1>{site.name}</h1></div><span class="gap"
            ></span>
          </div>
        </div>

        <div class="cmdblock" data-cmd={CMD.role}>
          <div class="line"><Prompt /><span class="cmd">{CMD.role}</span></div>
          <div class="blockout">
            <div class="line accent">{site.tagline}</div><span class="gap"
            ></span>
          </div>
        </div>

        <div class="cmdblock" data-cmd={CMD.about}>
          <div class="line"><Prompt /><span class="cmd">{CMD.about}</span></div>
          <div class="blockout">
            {site.about.map((l) => <div class="line out">{l}</div>)}<span
              class="gap"></span>
          </div>
        </div>

        <div class="cmdblock" data-cmd={CMD.contact}>
          <div class="line">
            <Prompt /><span class="cmd">{CMD.contact}</span>
          </div>
          <div class="blockout">
            <div class="contact">
              {
                contacts.map((c) => (
                  <>
                    <span class="k">{c.label}</span>
                    <a class="link" href={c.href} rel="me">
                      {c.display}
                    </a>
                  </>
                ))
              }
            </div><span class="gap"></span>
          </div>
        </div>

        <div class="line dim" id="hint">type `help` and press enter</div>
      </div>

      <div class="line inputline" id="inputline">
        <Prompt /><span id="typed" aria-hidden="true"></span><span
          class="cursor"
          aria-hidden="true"></span>
        <input
          id="cmd"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          enterkeyhint="go"
          aria-label="terminal command input"
        />
      </div>
    </div>
  </div>

  <p class="pagefoot"><a href="/datenschutz/">Datenschutz</a></p>

  {
    /*
    No `is:inline` anywhere on this page: Astro bundles this script, which is
    what lets `security.csp` cover it. Being a module it is also deferred, so
    the DOM is ready, and nothing leaks to `window`.
  */
  }
  <script>
    import "../scripts/shell.ts";
  </script>
</Base>
